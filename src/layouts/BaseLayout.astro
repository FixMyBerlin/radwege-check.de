---
import '@fontsource/barlow/300.css'
import '@fontsource/barlow'
import '@fontsource/barlow/600.css'
import '@fontsource/barlow/700.css'
import '@fontsource/barlow-semi-condensed'
import '@fontsource/barlow-semi-condensed/500.css'
import '@fontsource/barlow-semi-condensed/600.css'
import '@fontsource/barlow-semi-condensed/700.css'
import '@fontsource/barlow-condensed'
import '@fontsource/barlow-condensed/600.css'
import '@fontsource/barlow-condensed/700.css'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  lang?: string
}

const { title = 'Radwege-Check', description, lang = 'de' } = Astro.props
const matomoDev = !import.meta.env.PROD
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <script is:inline define:vars={{ matomoDev }}>
      var _paq = (window._paq = window._paq || [])
      _paq.push(['disableCookies'])
      _paq.push(['trackPageView'])
      _paq.push(['enableLinkTracking'])
      _paq.push(['setTrackerUrl', 'https://s.fixmycity.de/matomo.php'])
      _paq.push(['setSiteId', '6'])
      if (matomoDev) {
        window.dev = true
      }
      var d = document,
        g = d.createElement('script'),
        s = d.getElementsByTagName('script')[0]
      g.async = true
      g.src = 'https://s.fixmycity.de/matomo.js'
      s.parentNode.insertBefore(g, s)
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
