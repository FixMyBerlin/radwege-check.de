---
import Footer from '~/layouts/Footer.astro'
import { EnglishLanguageButton, EnglishLanguageModal } from '~/components/Layout/EnglishLanguage'

interface Props {
  /** `Astro.url.host` — drives the English-domain translation hint. */
  host: string
  showEnglishLanguageTeaser?: boolean
  /** Classes for the wrapping `<main>` (e.g. `bg-white`). */
  mainClass?: string
}

const { host, showEnglishLanguageTeaser = true, mainClass = '' } = Astro.props
---

<main class:list={['z-0 flex-grow', mainClass]}>
  <slot />
</main>
<Footer />
{
  showEnglishLanguageTeaser ? (
    <>
      <EnglishLanguageButton client:load visible={true} />
      <EnglishLanguageModal client:load visible={true} domain={host} />
    </>
  ) : null
}
{
  import.meta.env.DEV ? (
    <a
      class="border-xl fixed bottom-1 left-1 z-50 flex h-5 flex-row items-center space-x-1 rounded bg-pink-900 px-1 text-xs text-white shadow hover:underline print:hidden"
      href="https://tailwindcss.com/docs/responsive-design"
    >
      <span class="text-white" title="<640px">
        –
      </span>
      <span class="text-white/20 sm:text-white" title="640px">
        sm
      </span>
      <span class="text-white/20 md:text-white" title="768px">
        md
      </span>
      <span class="text-white/20 lg:text-white" title="1024px">
        lg
      </span>
      <span class="text-white/20 xl:text-white" title="1280px">
        xl
      </span>
      <span class="text-white/20 2xl:text-white" title="1536px">
        2xl
      </span>
    </a>
  ) : null
}
