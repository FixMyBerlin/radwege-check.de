---
import Footer from '~/layouts/Footer.astro'
import { EnglishLanguageButton, EnglishLanguageModal } from '~/components/Layout/EnglishLanguage'
import { TailwindResponsiveHelper } from '~/components/Layout/TailwindResponsiveHelper'

interface Props {
  /** `Astro.url.host` — drives the English-domain translation hint. */
  host: string
  showEnglishLanguageTeaser?: boolean
  /** Classes for the wrapping `<main>` (e.g. `bg-white`). */
  mainClass?: string
}

const { host, showEnglishLanguageTeaser = true, mainClass = '' } = Astro.props
---

<main class:list={['z-0 flex-grow', mainClass]}>
  <slot />
</main>
<Footer />
{
  showEnglishLanguageTeaser ? (
    <>
      <EnglishLanguageButton client:load visible={true} />
      <EnglishLanguageModal client:load visible={true} domain={host} />
    </>
  ) : null
}
<TailwindResponsiveHelper client:load />
