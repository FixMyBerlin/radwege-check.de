---
import { footerLinks } from '~/components/Layout/Footer/const/footerLinks.const'
import logoFmcMarkup from '~/components/Layout/Footer/assets/fixmycity-logo.svg?raw'
import logoMarkup from '~/components/assets/radwegecheck-logo.svg?raw'

import { linkInvertedClass } from '~/lib/link-classes'

const socialClass = 'text-stone-100 hover:text-yellow-100'
---

<footer
  class="-z-10 bg-stone-600 p-6 print:hidden lg:pb-8"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="flex justify-end space-x-6 pb-5 lg:hidden">
    <a
      href="https://www.linkedin.com/company/fixmycity"
      class:list={[socialClass, 'block']}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="sr-only">LinkedIn</span>
      <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 448 512" aria-hidden="true"
        ><path
          d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
        ></path></svg
      >
    </a>
    <a
      href="https://github.com/FixMyBerlin/fixmy.safetycheck"
      class:list={[socialClass, 'block']}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="sr-only">GitHub</span>
      <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
        ><path
          fill-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          clip-rule="evenodd"></path></svg
      >
    </a>
  </div>
  <div class="flex flex-col items-stretch justify-between lg:flex-row">
    <section class="flex flex-col justify-between pb-3 lg:w-auto lg:pb-0">
      <div>
        <a href="/" class="block" title="Zur Startseite…">
          <span
            class="inline-flex h-12 shrink-0 items-center justify-center text-white [&>svg]:block [&>svg]:max-h-full [&>svg]:max-w-full"
            set:html={logoMarkup}
            aria-label="Radwege-Check"
          />
        </a>
      </div>
      <div>
        <a
          href="https://www.fixmycity.de"
          class="text-xs text-stone-300 ml-[58px] -mt-0.5 -mb-1.5 block hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konzept &amp; Entwicklung FixMyCity{' '}
          <span
            class="ml-0.5 inline-block h-7 w-7 align-middle text-white [&>svg]:inline-block [&>svg]:h-full [&>svg]:w-full"
            set:html={logoFmcMarkup}
            aria-hidden="true"
          />
        </a>
      </div>
    </section>
    <section>
      <div class="mt-8 flex flex-col gap-10 lg:mt-1 lg:flex-row lg:gap-12">
        <div class="lg:w-[11rem] xl:w-[26rem]">
          <h3 class="mb-3 font-semibold text-stone-100">Über die Daten:</h3>
          <ul class="space-y-3">
            {
              footerLinks.report.map((item) => (
                <li>
                  <a
                    href={item.to}
                    class:list={['block text-base leading-5', linkInvertedClass]}
                    lang={item.lang}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="lg:w-[11rem]">
          <h3 class="mb-3 font-semibold text-stone-100">Ergebnisse:</h3>
          <ul class="space-y-3">
            {
              footerLinks.results.map((item) => (
                <li>
                  <a href={item.to} class:list={['block text-base leading-5', linkInvertedClass]}>
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="mb-5 lg:mb-0 lg:w-[11rem]">
          <ul class="space-y-3">
            {
              footerLinks.formal.map((item) => (
                <li>
                  <a
                    href={item.to}
                    class:list={['block text-base leading-5', linkInvertedClass]}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="hidden space-y-4 lg:flex lg:flex-col">
          <a
            href="https://www.linkedin.com/company/fixmycity"
            class:list={[socialClass, 'block']}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sr-only">LinkedIn</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 448 512" aria-hidden="true"
              ><path
                d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
              ></path></svg
            >
          </a>
          <a
            href="https://github.com/FixMyBerlin/fixmy.safetycheck"
            class:list={[socialClass, 'block']}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sr-only">GitHub</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path></svg
            >
          </a>
        </div>
      </div>
    </section>
  </div>
</footer>
