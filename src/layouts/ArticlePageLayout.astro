---
import clsx from 'clsx'
import ArticleHero from '~/layouts/ArticleHero.astro'
import SiteChrome from '~/layouts/SiteChrome.astro'

interface Props {
  host: string
  showEnglishLanguageTeaser?: boolean
  maxWidthClass?: string
  prose?: boolean
  printHideHeader?: boolean
}

const {
  host,
  showEnglishLanguageTeaser = true,
  maxWidthClass = 'max-w-prose',
  prose = true,
  printHideHeader = false,
} = Astro.props

const articleClass = clsx(
  maxWidthClass,
  prose && 'prose prose-headings:scroll-my-5 prose-li:marker:text-gray-800',
  'mx-auto max-w-2xl bg-white p-3 pt-8 sm:p-5 lg:rounded-md lg:p-10',
  { '-mt-20 mb-20': !printHideHeader },
)
---

<SiteChrome host={host} showEnglishLanguageTeaser={showEnglishLanguageTeaser} mainClass="bg-white">
  <ArticleHero printHideHeader={printHideHeader} />
  <article class={articleClass}>
    <slot />
  </article>
</SiteChrome>
