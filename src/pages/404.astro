---
import BaseLayout from '../layouts/BaseLayout.astro'
import { NotFoundRoute } from '../components/routes/NotFoundRoute'
import { siteLocationFromUrl } from '../lib/site-location'

const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout seo={{ noindex: true, title: '404 | Seite nicht gefunden.' }}>
  <NotFoundRoute client:only="react" location={location} />
</BaseLayout>
