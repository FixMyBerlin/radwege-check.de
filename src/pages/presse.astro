---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PresseRoute } from '../components/routes/PresseRoute'
import { siteLocationFromUrl } from '../lib/site-location'

const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout
  seo={{
    noindex: true,
    title: 'Radwege-Check | Presseinformationen',
    description:
      'Der Radwege-Check erlaubt es die Umfragedaten von 1.779 Varianten an Radweg-Führungsformen zu vergleichen.',
  }}
>
  <PresseRoute client:only="react" location={location} />
</BaseLayout>
