---
import BaseLayout from '../layouts/BaseLayout.astro'
import { OpenDataRoute } from '../components/routes/OpenDataRoute'
import { siteLocationFromUrl } from '../lib/site-location'

const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout
  seo={{
    noindex: true,
    title: 'Radwege-Check | OpenData, OpenSource',
    description: 'Die Daten dieses Projektes sind OpenData. Der Quellcode ist OpenSource.',
  }}
>
  <OpenDataRoute client:only="react" location={location} />
</BaseLayout>
