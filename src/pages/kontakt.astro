---
import BaseLayout from '../layouts/BaseLayout.astro'
import { KontaktRoute } from '../components/routes/KontaktRoute'
import { siteLocationFromUrl } from '../lib/site-location'

const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout seo={{ noindex: true, title: 'Radwege-Check | Kontakt & Impressum' }}>
  <KontaktRoute client:only="react" location={location} />
</BaseLayout>
