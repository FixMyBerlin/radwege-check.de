---
import BaseLayout from '../layouts/BaseLayout.astro'
import { IndexRoute } from '../components/routes/IndexRoute'
import { siteLocationFromUrl } from '../lib/site-location'

const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout
  seo={{
    title:
      'Radwege-Check – Vergleiche die subjektive Sicherheit von 1.779 Radinfrastrukturen.',
    sharingTitle: 'Vergleiche 1.779 Radinfrastrukturen. Mach den Radwege-Check.',
  }}
>
  <IndexRoute client:load="react" location={location} />
</BaseLayout>
