---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticlePageLayout from '../../layouts/ArticlePageLayout.astro'
import { getCollection } from 'astro:content'
import { NebenstrassenAlleRoute } from '../../components/routes/NebenstrassenAlleRoute'

const secondary = await getCollection('scenesSecondary')
const rawScenes = secondary.map((e) => ({
  node: e.data as Record<string, unknown>,
}))
const totalResults = Number(secondary.length).toLocaleString()
---

<BaseLayout
  seo={{
    article: true,
    noindex: true,
    title: `Alle ${totalResults} Szenen auf Nebenstrassen.`,
    description: 'Auf Basis eine Umfrage mit über 22.000 Teilnehmenden.',
    imagePath: '/social-sharing/results.jpg',
  }}
>
  <ArticlePageLayout host={Astro.url.host} maxWidthClass="max-w-full lg:mx-5" prose={false}>
    <NebenstrassenAlleRoute client:only="react" rawScenes={rawScenes} />
  </ArticlePageLayout>
</BaseLayout>
