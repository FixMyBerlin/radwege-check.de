---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { NebenstrassenExportRoute } from '../../components/routes/NebenstrassenExportRoute'
import { siteLocationFromUrl } from '../../lib/site-location'

const secondary = await getCollection('scenesSecondary')
const rawScenes = secondary.map((e) => ({
  node: e.data as Record<string, unknown>,
}))
const location = siteLocationFromUrl(Astro.url)
const totalResults = Number(secondary.length).toLocaleString()
---

<BaseLayout
  seo={{
    article: true,
    noindex: true,
    title: `Export-Ansicht aller ${totalResults} Szenen auf Nebenstrassen.`,
    description: 'Auf Basis eine Umfrage mit über 22.000 Teilnehmenden.',
    imagePath: '/social-sharing/results.jpg',
  }}
>
  <NebenstrassenExportRoute
    client:only="react"
    location={location}
    rawScenes={rawScenes}
  />
</BaseLayout>
