---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { HauptstrassenIndexRoute } from '../../components/routes/HauptstrassenIndexRoute'
import { siteLocationFromUrl } from '../../lib/site-location'

const primary = await getCollection('scenesPrimary')
const rawScenes = primary.map((e) => ({
  node: e.data as Record<string, unknown>,
}))
const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout
  seo={{
    title: 'Radwege-Check Hauptstrasse – Alle Varianten filtern',
  }}
>
  <HauptstrassenIndexRoute
    client:load="react"
    location={location}
    rawScenes={rawScenes}
  />
</BaseLayout>
