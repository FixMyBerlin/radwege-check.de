---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection, getEntry } from 'astro:content'
import { HauptstrassenSceneRoute } from '../../components/routes/HauptstrassenSceneRoute'
import { siteLocationFromUrl } from '../../lib/site-location'
import { cleanupCsvData } from '../../components/ScenesPage/utils/cleanupCsvData'
import type { ScenePrimaryProps } from '../../components/ScenesPage/types'

export async function getStaticPaths() {
  const scenes = await getCollection('scenesPrimary')
  return scenes.map((e) => ({
    params: { sceneId: String(e.data.sceneId) },
  }))
}

const sceneId = Astro.params.sceneId
if (!sceneId) return Astro.redirect('/404')

const entry = await getEntry('scenesPrimary', sceneId)
if (!entry) return Astro.redirect('/404')

const cleaned = cleanupCsvData([entry.data as Record<string, unknown>])[0]
const scene = {
  ...cleaned,
  path: `/hauptstrassen/${cleaned.sceneId}`,
} as ScenePrimaryProps
const location = siteLocationFromUrl(Astro.url)
---

<BaseLayout>
  <HauptstrassenSceneRoute client:only="react" location={location} scene={scene} />
</BaseLayout>
