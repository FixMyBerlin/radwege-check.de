{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "~/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["jest", "@testing-library/jest-dom"]
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "__helpers__",
    "__mocks__",
    "astro.config.mjs",
    "src/content.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
