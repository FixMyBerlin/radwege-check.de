{
  "name": "radwege-check.de",
  "description": "The website for https://radwege-check.de",
  "version": "1.0.0",
  "author": "FixMyCity <hello@fixmycity.de>",
  "license": "AGPL-3.0",
  "keywords": [],
  "scripts": {
    "start": "PARCEL_WORKERS=0 gatsby develop --open",
    "profile": "npm run start --profile",
    "mobile": "PARCEL_WORKERS=0 gatsby develop -H 0.0.0.0",
    "cs": "npm run clean && npm run start",
    "build": "PARCEL_WORKERS=0 gatsby build",
    "serve": "gatsby serve",
    "build-serve": "npm run build && npm run serve",
    "clean": "gatsby clean",
    "bleach": "rm -rf node_modules/ && npm install --legacy-peer-deps && npm run cs",
    "check": "npm run type-check && npm run lint && npm run format && npm run test",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.+(ts|js|tsx)\" --fix",
    "format": "prettier --ignore-path .gitignore \"src/**/*.+(ts|js|tsx)\" --write",
    "test": "DISABlE_DEBUG_FOR_JEST=true jest",
    "test:watch": "DISABlE_DEBUG_FOR_JEST=true jest --watch",
    "prepare": "husky install",
    "updatePackages:minor": "npx taze minor --write",
    "updatePackages:major": "npx taze major --write",
    "release": "gh pr create --base main --head develop --title \"Release $(date '+%Y-%m-%d')\" --body \"\""
  },
  "lint-staged": {
    "./src/**/*.{ts,js,jsx,tsx}": [
      "yarn lint --fix",
      "yarn format"
    ]
  },
  "dependencies": {
    "@fontsource/barlow": "5.2.8",
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/barlow-semi-condensed": "5.2.7",
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@parcel/core": "2.16.3",
    "@popperjs/core": "2.11.8",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "embla-carousel-react": "8.6.0",
    "fs-extra": "11.3.3",
    "gatsby": "5.16.0",
    "gatsby-plugin-image": "3.15.0",
    "gatsby-plugin-manifest": "5.15.0",
    "gatsby-plugin-matomo": "0.17.0",
    "gatsby-plugin-react-helmet": "6.15.0",
    "gatsby-plugin-sharp": "5.15.0",
    "gatsby-plugin-sitemap": "6.15.0",
    "gatsby-source-filesystem": "5.15.0",
    "gatsby-transformer-csv": "5.15.0",
    "itemsjs": "2.4.4",
    "query-string": "7.1.3",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-helmet": "6.1.0",
    "react-intl": "8.0.11",
    "react-popper": "2.3.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "use-query-params": "2.2.2",
    "zustand": "5.0.10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@parcel/namer-default": "2.16.3",
    "@tailwindcss/forms": "0.5.4",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "autoprefixer": "^10.4.23",
    "babel-jest": "30.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-gatsby": "3.15.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-formatjs": "6.0.10",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "29.12.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "gatsby-plugin-postcss": "6.15.0",
    "gatsby-plugin-react-svg": "3.3.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "postcss": "^8.5.6",
    "prettier": "3.8.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "4.1.18",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
