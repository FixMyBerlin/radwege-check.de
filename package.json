{
  "name": "radwege-check.de",
  "description": "The website for https://radwege-check.de",
  "version": "1.0.0",
  "packageManager": "bun@1.3.13",
  "author": "FixMyCity <hello@fixmycity.de>",
  "license": "AGPL-3.0",
  "keywords": [],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "bun run type-check && bun run lint && bun run format:check && bun run test",
    "type-check": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "test": "DISABlE_DEBUG_FOR_JEST=true NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:watch": "DISABlE_DEBUG_FOR_JEST=true NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --watch",
    "prepare": "husky install",
    "updatePackages:minor": "bunx taze minor --write",
    "updatePackages:major": "bunx taze major --write",
    "release": "gh pr create --base main --head develop --title \"Release $(date '+%Y-%m-%d')\" --body \"\""
  },
  "lint-staged": {
    "./src/**/*.{ts,tsx}": ["oxlint --fix", "oxfmt"]
  },
  "dependencies": {
    "@fontsource/barlow": "5.2.8",
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/barlow-semi-condensed": "5.2.7",
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@popperjs/core": "2.11.8",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "astro": "^5.15.0",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "embla-carousel-react": "8.6.0",
    "itemsjs": "2.4.4",
    "nuqs": "^2.8.1",
    "query-string": "7.1.3",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-helmet": "6.1.0",
    "react-intl": "8.0.11",
    "react-popper": "2.3.0",
    "zustand": "5.0.10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260511.1",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "^6.1.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.32.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.18",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
