{
  "name": "radwege-check.de",
  "version": "1.0.0",
  "description": "The website for https://radwege-check.de",
  "keywords": [],
  "license": "AGPL-3.0",
  "author": "FixMyCity <hello@fixmycity.de>",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "bun run type-check && bun run lint && bun run format:check && bun run knip && bun run test",
    "knip": "knip",
    "type-check": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts",
    "format": "oxfmt src package.json tsconfig.json astro.config.mjs oxfmt.config.mjs vitest.config.ts oxlint.config.ts knip.config.ts scripts/strip-react-fc.ts __helpers__ public/manifest.webmanifest taze.config.js",
    "format:check": "oxfmt --check src package.json tsconfig.json astro.config.mjs oxfmt.config.mjs vitest.config.ts oxlint.config.ts knip.config.ts scripts/strip-react-fc.ts __helpers__ public/manifest.webmanifest taze.config.js",
    "test": "DISABlE_DEBUG_FOR_JEST=true vitest run",
    "test:watch": "DISABlE_DEBUG_FOR_JEST=true vitest",
    "prepare": "husky install",
    "strip-react-fc": "bun scripts/strip-react-fc.ts",
    "updatePackages:minor": "bunx taze minor --write",
    "updatePackages:major": "bunx taze major --write",
    "release": "gh pr create --base main --head develop --title \"Release $(date '+%Y-%m-%d')\" --body \"\""
  },
  "dependencies": {
    "@fontsource/barlow": "5.2.8",
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/barlow-semi-condensed": "5.2.7",
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "astro": "^6.3.1",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "embla-carousel-react": "8.6.0",
    "itemsjs": "2.4.4",
    "nuqs": "^2.8.9",
    "query-string": "7.1.3",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-intl": "8.0.11",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/bun": "1.3.14",
    "@types/node": "25.0.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260511.1",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "^6.2.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "^5.64.3",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tailwindcss": "4.1.18",
    "taze": "19.11.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "lint-staged": {
    "./src/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "./package.json": [
      "oxfmt"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "packageManager": "bun@1.3.13"
}
